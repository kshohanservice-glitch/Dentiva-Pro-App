{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dentiva Pro",
  "version": "1.0.0",
  "identifier": "com.dentivapro.app",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist-web",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Dentiva Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: asset:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "category": "Medical",
    "shortDescription": "Offline dental clinic management",
    "longDescription": "Dentiva Pro — premium offline-first dental clinic/practice management for Windows.",
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": ["English"],
        "displayLanguageSelector": false
      }
    }
  }
}
